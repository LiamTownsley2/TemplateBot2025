generator client {
  provider = "prisma-client"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
}
model user {
  id             String   @id
  username       String
  global_name    String?
  avatar         String?
  banner         String?
  accent_color   Int?
  created_at     DateTime @db.Timestamptz(6)
  locale         String?
  level         Int       @default(0)
  xp            BigInt    @default(0)
  balance       BigInt    @default(0)
  is_premium     Boolean   @default(false)
  bio           String?
  settings      Json?
  last_active    DateTime? @db.Timestamptz
}

model guild {
  id             String   @id
  name           String
  is_premium     Boolean   @default(false)
  created_at     DateTime @db.Timestamptz(6)
  last_active    DateTime? @db.Timestamptz
}
