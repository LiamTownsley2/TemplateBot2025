{
  "name": "template-bot",
  "version": "1.0.4",
  "main": "src/index.js",
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && npm run sentry:sourcemaps",
    "rebuild": "npm run docker:down && npm run docker:build && npm run docker:up",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose build --no-cache",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org lalala-pt --project node ./dist && sentry-cli sourcemaps upload --org lalala-pt --project node ./dist",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:migrate:reset": "npx prisma migrate reset",
    "prisma:studio": "npx prisma studio",
    "prisma:db:push": "npx prisma db push",
    "prisma:migrate:postgres": "dotenv -e .env.postgres -- npx prisma migrate dev",
    "prisma:migrate:sqlite": "dotenv -e .env.sqlite -- npx prisma db push",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "dev:db": "npm run prisma:generate && npm run prisma:migrate:dev"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.2.0",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/adapter-planetscale": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/cli": "^2.58.4",
    "@sentry/node": "^10.32.1",
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@planetscale/database": "^1.19.0",
    "@types/i18n": "^0.13.12",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "mysql2": "^3.16.0",
    "neon-serverless": "^0.5.3",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
