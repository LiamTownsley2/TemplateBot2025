generator client {
  provider = "prisma-client"
  output   = "../src/prisma/client/client"
}

datasource db {
  provider = "postgresql"
}
model users {
  id             BigInt   @id
  username       String
  global_name    String?
  avatar         String?
  banner         String?
  accent_color   Int?
  created_at     DateTime @db.Timestamptz(6)

  level         Int       @default(0)
  xp            BigInt    @default(0)
  balance       BigInt    @default(0)
  is_premium     Boolean   @default(false)
  bio           String?
  settings      Json?
  last_active    DateTime? @db.Timestamptz
}
